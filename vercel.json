{
    "services": {
        "my_frontend": {
            "root": "frontend/"
        },
        "my_backend": {
            "root": "backend/",
            "entrypoint": "server.js"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": {
                "service": "my_backend"
            }
        },
        {
            "source": "/(.*)",
            "destination": {
                "service": "my_frontend"
            }
        }
    ]
}